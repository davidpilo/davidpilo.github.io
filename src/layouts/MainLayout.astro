---
import 'normalize.css';
import '@fontsource-variable/jetbrains-mono';

import '../styles/base.css';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />

    <script is:inline>
      const t = localStorage.getItem('theme') ?? 'light';
      document.documentElement.setAttribute('data-theme', t);
    </script>

    <link rel="icon" href="/favicon.png" />

		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />

		<title>David Pilo</title>

		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://davidpilo.com/" />
		<meta property="og:title" content="David Pilo" />
		<meta property="og:description" content="Founder & CEO of Walcu" />
		<meta property="og:image" content="https://davidpilo.com/favicon.png" />

		<meta name="twitter:card" content="summary" />
		<meta name="twitter:url" content="https://davidpilo.com/" />
		<meta name="twitter:title" content="David Pilo" />
		<meta name="twitter:description" content="Founder & CEO of Walcu" />
		<meta name="twitter:image" content="https://davidpilo.com/favicon.png" />
	</head>
	<body>
    <slot />
	</body>
</html>
