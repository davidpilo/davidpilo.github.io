---
import { excerpt } from '../lib/excerpt.js';
import { getCollection } from 'astro:content';

import MainLayout from '../layouts/MainLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import Section from '../components/Section.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ProjectCard from '../components/ProjectCard.astro';

const PAGE_BLOG = '/blog';

const projects = [
  {
    title: 'PVTS — Visual Interpreter',
    description: 'Ever wondered what the Quicksort Algorithm looks like? Visualize lists, pointers and function calls in your code. PVTS is a visual interpreter for the Scheme functional programming language.',
    href: '/projects/pvts',
    repo: 'https://github.com/davidpilo/pvts',
  },
];

const articles = (await getCollection('blog'))
  .sort((a, b) => b.data.date - a.data.date)
  .slice(0, 4)
  .map(({ body, data, slug }) => ({
    date: data.date,
    excerpt: excerpt(body, 180),
    href: `${PAGE_BLOG}/post/${slug}`,
    title: data.title
  }));
---

<MainLayout>
  <div class="page-body">
    <Sidebar showBio={false} />
    <main>
      <Section title="bio" id="bio">
        <p>
          I’m the founder and CEO of Walcu, the CRM that 3,000 auto
          dealers across 9 countries use to run their sales.
        </p>
        <p>
          I studied Mathematics and Computer Science at Rollins College
          and earned a master’s in Operations Research from Cornell. I then
          spent two years at Microsoft as a Program Manager on Excel, where
          I helped ship Excel for the web.
        </p>
        <p>
          From there I moved into cars as a Digital Strategist at Canalcar,
          a leading used car retailer. Up close, the gap was obvious: dealer
          software was either well engineered or built for how dealers
          actually work, never both. I started Walcu in 2019 to be both.
        </p>
        <p>
          Here I write about engineering and management. If that’s your
          thing, follow me on <a class="bio-link" href="https://linkedin.com/in/david-pilo">LinkedIn</a>
          or subscribe via <a class="bio-link" href="/blog/rss.xml">RSS</a>.
        </p>
      </Section>

      <Section title="last_updates" href={PAGE_BLOG}>
        <div class="articles-grid">
          {articles.map(article => (
            <ArticleCard {...article} />
          ))}
        </div>
      </Section>

      <Section title="projects" id="projects">
        {projects.map(project => (
          <ProjectCard {...project} />
        ))}
      </Section>
    </main>
  </div>
</MainLayout>

<style>
  .bio-link {
    color: var(--section-title);
  }

  .page-body {
    display: flex;
    margin: 0 auto;
    max-width: 72rem;
  }

  main {
    border-left: 1px solid var(--sidebar-border);
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 2.5rem;
    padding: 2rem 2.5rem;
  }

  main p {
    border-color: var(--section-line);
    border-style: solid;
    border-width: 0px 1px;
    color: var(--body-fg);
    font-size: 0.85rem;
    line-height: 1.75;
    margin: 0;
    padding-left: 1rem;
  }

  .articles-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(2, 1fr);
  }

  :global([data-theme="dark"]) main p {
    color: var(--p-color);
  }

  @media (max-width: 1199px) {
    .page-body {
      flex-direction: column;
    }

    main {
      border-left: none;
      border-top: 1px solid var(--sidebar-border);
      padding: 2rem 1rem;
    }
  }

  @media (max-width: 779px) {
    main p {
      padding: 0 1rem;
    }

    .articles-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
